+/* kbase: tiler heap chunks are only returned when a heap generation is
+ * renewed between submissions (no FRAGMENT_COMPLETED heap ops), so inside one
+ * command buffer every render pass the vertex/tiler subqueue finishes ahead of
+ * the fragment subqueue keeps its tiler memory. Chromium on Zink records
+ * hundreds of passes per command buffer: the VT subqueue ran ~70 passes ahead,
+ * the heap ran out mid-pass (tiler OOM), and the fragment subqueue could not
+ * catch up because the VT pass signals it waits for are deferred on iterator
+ * scoreboards shared with the stuck pass - a deadlock. Bound the lead: at the
+ * end of each VT pass, wait until the fragment subqueue is at most
+ * PANVK_KBASE_VT_LEAD passes behind (default 8, 0 disables). */
+static uint32_t
+kbase_vt_lead(void)
+{
+   static int64_t lead = -1;
+
+   if (lead < 0)
+      lead = MAX2(debug_get_num_option("PANVK_KBASE_VT_LEAD", 8), 0);
+
+   return (uint32_t)lead;
+}
+
+static void
+throttle_vt_lead(struct panvk_cmd_buffer *cmdbuf)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(cmdbuf->vk.base.device->physical);
+   const uint32_t lead = MIN2(kbase_vt_lead(), 32);
+   const struct panvk_cs_state *vt =
+      &cmdbuf->state.cs[PANVK_SUBQUEUE_VERTEX_TILER];
+   const int32_t target_pass = vt->relative_sync_point - (int32_t)lead;
+
+   if (!phys_dev->kbase_node_path[0] || !lead || target_pass < 1 ||
+       vt->kbase_lead_vt[target_pass & 63] != target_pass)
+      return;
+
+   /* Done once the fragment subqueue has signalled that pass's fragment job:
+    * one past the fragment sync point recorded just before it. Same
+    * GREATER-than-base convention as wait_finish_tiling(). */
+   const int32_t frag_done = vt->kbase_lead_frag[target_pass & 63] + 1;
+
+   struct cs_builder *b =
+      panvk_get_cs_builder(cmdbuf, PANVK_SUBQUEUE_VERTEX_TILER);
+   struct cs_index frag_sync_addr = cs_scratch_reg64(b, 0);
+   struct cs_index frag_point = cs_scratch_reg64(b, 2);
+
+   cs_load64_to(b, frag_sync_addr, cs_subqueue_ctx_reg(b),
+                offsetof(struct panvk_cs_subqueue_context, syncobjs));
+   cs_add_imm64(b, frag_sync_addr, frag_sync_addr,
+                PANVK_SUBQUEUE_FRAGMENT * sizeof(struct panvk_cs_sync64));
+   cs_add_imm64(b, frag_point,
+                cs_progress_seqno_reg(b, PANVK_SUBQUEUE_FRAGMENT), frag_done);
+   panvk_instr_sync64_wait(cmdbuf, PANVK_SUBQUEUE_VERTEX_TILER, false,
+                           MALI_CS_CONDITION_GREATER, frag_point,
+                           frag_sync_addr);
+#endif
+}
